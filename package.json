{
  "name": "orbit-dashboards-root",
  "version": "1.0.0",
  "private": true,
  "description": "Orbit Dashboards root proxy forwarding all commands to Building-cosmic",
  "scripts": {
    "start": "npm --prefix Building-cosmic start",
    "start:cosmic": "npm --prefix Building-cosmic run start:cosmic",
    "start:comic": "npm --prefix Building-cosmic run start:comic",
    "dev": "npm --prefix Building-cosmic run dev",
    "dev:cosmic": "npm --prefix Building-cosmic run dev:cosmic",
    "dev:comic": "npm --prefix Building-cosmic run dev:comic",
    "build": "npm --prefix Building-cosmic run build",
    "build:unpack": "npm --prefix Building-cosmic run build:unpack",
    "test": "npm --prefix Building-cosmic test",
    "test:watch": "npm --prefix Building-cosmic run test:watch",
    "typecheck": "npm --prefix Building-cosmic run typecheck",
    "typecheck:node": "npm --prefix Building-cosmic run typecheck:node",
    "typecheck:web": "npm --prefix Building-cosmic run typecheck:web",
    "verify:boundary": "npm --prefix Building-cosmic run verify:boundary",
    "lint": "npm --prefix Building-cosmic run lint",
    "format": "npm --prefix Building-cosmic run format",
    "ci": "npm --prefix Building-cosmic run ci"
  }
}
